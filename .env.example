# Copy nothing from here by hand: scripts/create-local-credentials.mjs writes the real
# files with random tokens. This file only documents what they contain.

# .env.local (the web app and the owner)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
CHAT_USER_TOKEN=64-hex-characters

# .env.agent-claude.local, .env.agent-gpt.local, .env.agent-gemini.local (one per agent)
# CHAT_CLAUDE_TOKEN=64-hex-characters
# CHAT_GPT_TOKEN=64-hex-characters
# CHAT_GEMINI_TOKEN=64-hex-characters

# Optional
# CHAT_BASE_URL=http://localhost:3000
# HFMA_WORK_ROOT=C:/path/to/WORK
# Page background: a file you put in public/. Plain matte black when unset.
# NEXT_PUBLIC_BACKGROUND_IMAGE=/background.png
